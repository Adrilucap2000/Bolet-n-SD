<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Departamento de Salud Digital</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #ffffff;
        }

        /* =========================
           BARRA SUPERIOR
        ========================= */

        .navbar {
            width: 100%;
            height: 86px;
            background: #0b416d;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 4%;
        }

        /* LOGOTIPO */

        .logo {
            display: flex;
            align-items: center;
            height: 100%;
        }

        .logo img {
            height: 55px;
            width: auto;
            object-fit: contain;
        }

        /* =========================
           MENÚ
        ========================= */

        .menu {
            display: flex;
            align-items: center;
            gap: 38px;
            height: 100%;
        }

        .menu a,
        .dropdown-btn {
            color: white;
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s ease;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .menu a:hover,
        .dropdown-btn:hover {
            color: #d5b000;
        }

        /* =========================
           MENÚ DESPLEGABLE
        ========================= */

        .dropdown {
            position: relative;
            height: 100%;
            display: flex;
            align-items: center;
        }

        .dropdown-menu {
            position: absolute;
            top: 86px;
            left: 0;

            min-width: 190px;

            background: white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);

            display: none;
            flex-direction: column;

            border-top: 3px solid #d5b000;
            z-index: 1000;
        }

        .dropdown-menu a {
            color: #0b416d;
            padding: 14px 18px;
            font-size: 14px;
            font-weight: 500;
        }

        .dropdown-menu a:hover {
            background: #f2f2f2;
            color: #0b416d;
        }

        .dropdown:hover .dropdown-menu {
            display: flex;
        }

        /* FLECHA */

        .arrow {
            font-size: 12px;
        }

        /* =========================
           BÚSQUEDA
        ========================= */

        .search {
            width: 22px;
            height: 22px;
            border: 2px solid white;
            border-radius: 50%;
            position: relative;
            margin-left: 5px;
            cursor: pointer;
        }

        .search::after {
            content: "";
            position: absolute;
            width: 9px;
            height: 2px;
            background: white;
            right: -7px;
            bottom: -4px;
            transform: rotate(-48deg);
            border-radius: 2px;
        }

        /* =========================
           CONTENIDO DE PRUEBA
        ========================= */

        .contenido {
            height: 500px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #0b416d;
            font-size: 40px;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 900px) {

            .navbar {
                height: auto;
                min-height: 75px;
                padding: 12px 5%;
                flex-wrap: wrap;
            }

            .logo img {
                height: 45px;
            }

            .menu {
                width: 100%;
                justify-content: center;
                flex-wrap: wrap;
                gap: 20px;
                padding: 15px 0 5px;
            }

            .menu a,
            .dropdown-btn {
                font-size: 14px;
            }

            .dropdown-menu {
                top: 35px;
            }
        }

        @media (max-width: 600px) {

            .navbar {
                justify-content: center;
            }

            .menu {
                gap: 15px;
            }

            .menu a,
            .dropdown-btn {
                font-size: 13px;
            }

            .search {
                width: 19px;
                height: 19px;
            }
        }

    </style>
</head>

<body>

    <!-- =========================
         BARRA SUPERIOR
    ========================= -->

    <header class="navbar">

        <!-- LOGOTIPO -->
        <div class="logo">
            <img src="logo-salud-digital.png"
                 alt="Departamento de Salud Digital">
        </div>


        <!-- MENÚ -->
        <nav class="menu">

            <a href="#">Inicio</a>


            <!-- DEPARTAMENTO -->
            <div class="dropdown">

                <div class="dropdown-btn">
                    Departamento
                    <span class="arrow">⌄</span>
                </div>

                <div class="dropdown-menu">
                    <a href="#">¿Quiénes somos?</a>
                    <a href="#">Misión y visión</a>
                    <a href="#">Personal</a>
                    <a href="#">Contacto</a>
                </div>

            </div>


            <!-- ALUMNOS -->
            <div class="dropdown">

                <div class="dropdown-btn">
                    Alumnos
                    <span class="arrow">⌄</span>
                </div>

                <div class="dropdown-menu">
                    <a href="#">Cursos</a>
                    <a href="#">Aula virtual</a>
                    <a href="#">Recursos</a>
                    <a href="#">Actividades</a>
                </div>

            </div>


            <!-- INVESTIGACIÓN -->
            <div class="dropdown">

                <div class="dropdown-btn">
                    Investigación
                    <span class="arrow">⌄</span>
                </div>

                <div class="dropdown-menu">
                    <a href="#">Proyectos</a>
                    <a href="#">Publicaciones</a>
                    <a href="#">Líneas de investigación</a>
                </div>

            </div>


            <!-- ENDIBA -->
            <a href="#">ENDIBA</a>


            <!-- BÚSQUEDA -->
            <div class="search"></div>

        </nav>

    </header>


    <!-- CONTENIDO -->
    <main class="contenido">

        Departamento de Salud Digital

    </main>

</body>
</html>
